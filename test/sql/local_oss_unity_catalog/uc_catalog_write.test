# name: test/sql/local_oss_unity_catalog/uc_catalog_write.test
# description: test uc_catalog extension with writes
# group: [local_oss_unity_catalog]

# Require statement will ensure this test is run with this extension loaded
require parquet

require httpfs

require delta

require unity_catalog

require-env UC_TEST_SERVER_RUNNING

# require-env UC_TEST_SERVER_WRITE_TESTS

statement ok
CREATE SECRET (
    TYPE UC,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

# Catalog Secret
statement ok
ATTACH 'unity' AS my_catalog (TYPE UC_CATALOG, DEFAULT_SCHEMA 'default');

# We can switch to a specific schema
statement ok
USE my_catalog.default;

# We can now query the tables in the schema!
statement ok
FROM marksheet;

statement ok
INSERT INTO marksheet VALUES(1001, 'blabla', 1337);

# Second insert verifies PlanInsert credential ordering (RefreshCredentials before InternalAttach).
# marksheet is not catalog-managed (no delta.feature.catalogManaged property), so no backfill applies here.
statement ok
INSERT INTO marksheet VALUES(1002, 'blabla2', 1338);

query III
SELECT id, name, marks FROM marksheet WHERE id IN (1001, 1002) ORDER BY id;
----
1001	blabla	1337
1002	blabla2	1338
