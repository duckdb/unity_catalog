# name: test/oss_local/table-cmt/no_default_schema.test
# description: a catalog-managed table reads and writes, fully qualified, from a UC catalog attached WITHOUT DEFAULT_SCHEMA. OSS UC exposes no default namespace, so the attach has no default schema; delta finds the commit function in the table's own schema (duckdb/duckdb-delta#421), not via `main` (#150). Paired no_default_schema.py declares the server (uc_server) and provisions a unique empty duck.cmt.{UC_TEST_TABLE}.
# group: [table-cmt]

require parquet

require unity_catalog

require delta

require httpfs

require-env UC_TEST_CATALOG

require-env UC_TEST_TABLE

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH '{UC_TEST_CATALOG}' (TYPE unity_catalog);

query I
SELECT count(*) FROM duck.cmt.{UC_TEST_TABLE};
----
0

statement ok
INSERT INTO duck.cmt.{UC_TEST_TABLE} VALUES (1, 'one'), (2, 'two');

query II
SELECT id, name FROM duck.cmt.{UC_TEST_TABLE} ORDER BY id;
----
1	one
2	two
