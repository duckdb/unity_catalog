# name: test/oss_local/table-cmt/create_table.test
# description: CREATE TABLE in a catalog-managed schema: DuckDB stages the table with UC, writes version 0 through UC's committer, registers it, and then reads and writes it like any other managed table. Paired create_table.py picks the (unused) name and deletes the table afterwards.
# group: [table-cmt]

require parquet

require unity_catalog

require delta

require httpfs

require-env UC_TEST_CATALOG

require-env UC_TEST_NEW_TABLE

require-env UC_TEST_NEW_NESTED_TABLE

require-env UC_TEST_NEW_PARTITIONED_TABLE

require-env UC_ENDPOINT

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT '{UC_ENDPOINT}',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH '{UC_TEST_CATALOG}' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'cmt');

statement ok
CALL enable_logging(level='DEBUG');

# -----------------------------------------------------------------------------
# Creating it
#

statement ok
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE} (id INTEGER, name VARCHAR);

# The three calls the flow is made of, in order: UC allocates, DuckDB writes version 0, UC registers
query I
SELECT count(*) FROM duckdb_logs()
WHERE message LIKE 'api.CreateStagingTable {UC_TEST_CATALOG}.cmt.{UC_TEST_NEW_TABLE}%';
----
1

query I
SELECT count(*) FROM duckdb_logs()
WHERE message LIKE 'api.CreateTable {UC_TEST_CATALOG}.cmt.{UC_TEST_NEW_TABLE}%';
----
1

# UC suggests column mapping, which a table of top-level columns takes (column_mapping.test)
query I
SELECT count(*) FROM duckdb_logs()
WHERE message = 'CreateTable {UC_TEST_CATALOG}.cmt.{UC_TEST_NEW_TABLE} skipped suggested property delta.columnMapping.mode';
----
0

# The catalog serves it, with the columns as written. Scoped to the attachment: once a table has been
# resolved, the internal Delta database holding it is attached too, and duckdb_columns() reports both.
query II
SELECT column_name, data_type FROM duckdb_columns()
WHERE database_name = 'duck' AND table_name = '{UC_TEST_NEW_TABLE}' ORDER BY column_index;
----
id	INTEGER
name	VARCHAR

# -----------------------------------------------------------------------------
# Creating it again
#

statement ok
CREATE TABLE IF NOT EXISTS duck.cmt.{UC_TEST_NEW_TABLE} (id INTEGER, name VARCHAR);

# The catalog refused the second staging attempt, and the table it refused for is untouched
query II
SELECT column_name, data_type FROM duckdb_columns()
WHERE database_name = 'duck' AND table_name = '{UC_TEST_NEW_TABLE}' ORDER BY column_index;
----
id	INTEGER
name	VARCHAR

# It was the catalog that refused: the name was staged a second time, and nothing was registered.
# A check against the tables already loaded would have skipped the staging call altogether.
query II
SELECT
    count(*) FILTER (WHERE message LIKE 'api.CreateStagingTable {UC_TEST_CATALOG}.cmt.{UC_TEST_NEW_TABLE}%'),
    count(*) FILTER (WHERE message LIKE 'api.CreateTable {UC_TEST_CATALOG}.cmt.{UC_TEST_NEW_TABLE}%')
FROM duckdb_logs();
----
2	1

statement error
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE} (id INTEGER, name VARCHAR);
----
already exists

# -----------------------------------------------------------------------------
# Using it
#
# A managed table is only usable if the catalog owns its commits, so an INSERT here goes through
# UpdateTable the same way it does for a table the catalog made.
#

statement ok
INSERT INTO duck.cmt.{UC_TEST_NEW_TABLE} VALUES (1, 'one'), (2, 'two');

query II
SELECT id, name FROM duck.cmt.{UC_TEST_NEW_TABLE} ORDER BY id;
----
1	one
2	two

# At least once: a commit and its backfill both go through this endpoint
query I
SELECT count(*) >= 1 FROM duckdb_logs()
WHERE message LIKE 'api.UpdateTable {UC_TEST_CATALOG}.cmt.{UC_TEST_NEW_TABLE}%';
----
true

# -----------------------------------------------------------------------------
# A session that did not create it
#
# The rows have to be there for a connection that only ever saw the catalog's copy of the table.
#

statement ok
CALL disable_logging();

statement ok
DETACH duck;

statement ok
ATTACH '{UC_TEST_CATALOG}' AS fresh (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'cmt');

query II
SELECT id, name FROM fresh.cmt.{UC_TEST_NEW_TABLE} ORDER BY id;
----
1	one
2	two

# -----------------------------------------------------------------------------
# Nested columns
#
# A list, a map and a struct, because UC spells the parts of a nested type with dashes where the
# Delta log spells them in camelCase, and a column whose element type never reaches the server
# comes back as a table nobody can read. This runs on the attachment that just read the table
# above, so it also covers a CREATE in a session that already has tables in hand.
#

statement ok
CREATE TABLE fresh.cmt.{UC_TEST_NEW_NESTED_TABLE} (
    tags VARCHAR[],
    scores MAP(VARCHAR, INTEGER),
    who STRUCT(first VARCHAR, ages INTEGER[])
);

statement ok
INSERT INTO fresh.cmt.{UC_TEST_NEW_NESTED_TABLE}
VALUES (['a', 'b'], MAP {'x': 1}, {'first': 'ann', 'ages': [3, 4]});

query II
SELECT id, name FROM fresh.cmt.{UC_TEST_NEW_TABLE} ORDER BY id;
----
1	one
2	two

statement ok
DETACH fresh;

statement ok
ATTACH '{UC_TEST_CATALOG}' AS nested (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'cmt');

query III
SELECT tags, scores, who FROM nested.cmt.{UC_TEST_NEW_NESTED_TABLE};
----
[a, b]	{x=1}	{'first': ann, 'ages': [3, 4]}

statement ok
DETACH nested;

# -----------------------------------------------------------------------------
# What a CREATE here refuses
#
# Each of these is a table the statement cannot describe faithfully, so it has to fail rather than
# create something else. The names are per run because a refusal from the Delta writer comes after
# the name was staged.
#

statement ok
ATTACH '{UC_TEST_CATALOG}' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'cmt');

statement ok
ATTACH '{UC_TEST_CATALOG}' AS ro (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'cmt', READ_ONLY);

statement error
CREATE TABLE ro.cmt.{UC_TEST_NEW_TABLE}_ro (id INTEGER);
----
attached in read-only mode

statement error
CREATE OR REPLACE TABLE duck.cmt.{UC_TEST_NEW_TABLE}_replace (id INTEGER);
----
REPLACE ON CONFLICT in CreateTable

statement error
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE}_as AS SELECT 1 AS id;
----
PlanCreateTableAs

statement error
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE}_notnull (id INTEGER NOT NULL);
----
does not support NOT NULL constraints

statement error
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE}_pk (id INTEGER PRIMARY KEY);
----
does not support constraints

statement error
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE}_time (t TIME);
----
does not support column 't' of type TIME

# DuckDB cannot apply a Delta column default, so a table with one would get NULLs instead
statement error
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE}_default (id INTEGER, n INTEGER DEFAULT 1);
----
does not support DEFAULT values

statement error
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE}_default_null (id INTEGER, n INTEGER DEFAULT NULL);
----
does not support DEFAULT values

statement error
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE}_generated (id INTEGER, twice INTEGER GENERATED ALWAYS AS (id * 2));
----
does not support generated columns

# -----------------------------------------------------------------------------
# Partitioned
#
# PARTITIONED BY reaches the Delta writer, which lays the rows out by partition. Paired
# create_table.py checks that UC registered the partition column too, which SQL cannot see.
#

statement ok
CREATE TABLE duck.cmt.{UC_TEST_NEW_PARTITIONED_TABLE} (id INTEGER, p VARCHAR) PARTITIONED BY (p);

statement ok
INSERT INTO duck.cmt.{UC_TEST_NEW_PARTITIONED_TABLE} VALUES (1, 'a'), (2, 'b'), (3, 'a');

query II
SELECT p, count(*) FROM duck.cmt.{UC_TEST_NEW_PARTITIONED_TABLE} GROUP BY p ORDER BY p;
----
a	2
b	1

# Inside a transaction
#
# The catalog registers the table during the CREATE itself, so a ROLLBACK does not undo it: the
# table stays, empty and usable. Spark has no multi-statement transactions to compare with, and this
# pins the current behaviour so that a change to it is a deliberate one.
#

statement ok
BEGIN;

statement ok
CREATE TABLE duck.cmt.{UC_TEST_NEW_TABLE}_rolledback (id INTEGER);

statement ok
ROLLBACK;

query I
SELECT count(*) FROM duck.cmt.{UC_TEST_NEW_TABLE}_rolledback;
----
0

statement ok
INSERT INTO duck.cmt.{UC_TEST_NEW_TABLE}_rolledback VALUES (1);

query I
SELECT count(*) FROM duck.cmt.{UC_TEST_NEW_TABLE}_rolledback;
----
1

