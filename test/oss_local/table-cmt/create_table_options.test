# name: test/oss_local/table-cmt/create_table_options.test
# description: What a CREATE TABLE in a Unity Catalog schema accepts in its WITH clause. DuckDB's base catalog refuses every WITH clause before binding finishes, so without the extension's own SupportsCreateTable none of these messages could be reached. Paired create_table_options.py only wants the server attached: each statement is refused before any table is created.
# group: [table-cmt]

require parquet

require unity_catalog

require delta

require httpfs

require-env UC_TEST_CATALOG

require-env UC_ENDPOINT

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT '{UC_ENDPOINT}',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH '{UC_TEST_CATALOG}' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'cmt');

# -----------------------------------------------------------------------------
# What a location has to be
#
# UC would resolve a relative path against the server's own working directory, which no client can
# read, so only an absolute path or a URI is taken. The check applies to the evaluated value.
#

statement error
CREATE TABLE duck.cmt.opts_location (id INTEGER) WITH (location = 'relative/opts_location');
----
must be an absolute path or a URI

statement error
CREATE TABLE duck.cmt.opts_location (id INTEGER) WITH (location = concat('relative/', 'opts_location'));
----
must be an absolute path or a URI, found 'relative/opts_location'

statement error
CREATE TABLE duck.cmt.opts_location (id INTEGER) WITH (location = NULL);
----
NULL is not a valid CREATE TABLE location

# -----------------------------------------------------------------------------
# what else the clause takes
#

statement error
CREATE TABLE duck.cmt.opts_unknown (id INTEGER) WITH (nonsense = 'x');
----
Unrecognized option "nonsense"

# Table properties are refused like any other option, including the ones that would decide the
# table's protocol: UC states what the table must be.
statement error
CREATE TABLE duck.cmt.opts_feature (id INTEGER) WITH ("delta.feature.catalogManaged" = 'supported');
----
Unrecognized option

statement error
CREATE TABLE duck.cmt.opts_sorted (id INTEGER) SORTED BY (id);
----
SORTED BY is not supported
