# name: test/oss_local/writer_statement_shapes.test
# description: inserts that do not match the table's column order or width, through the UC catalog path -- writer_statement_shapes.py fans this body out over cmt and plain
# group: [oss_local]

require parquet

require unity_catalog

require delta

require httpfs

require-env UC_TEST_CATALOG

require-env UC_TEST_SCHEMA

require-env UC_TEST_TABLE

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH '{UC_TEST_CATALOG}' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA '{UC_TEST_SCHEMA}');

statement ok
USE duck.{UC_TEST_SCHEMA};

# -----------------------------------------------------------------------------
# Columns named, in the other order
#
# The table is (id INT, name STRING), so a plan that reaches the writer in statement order puts a
# string where the int belongs -- which fails loudly, or lands in the wrong column and does not.
#

statement ok
INSERT INTO {UC_TEST_TABLE} BY NAME SELECT 'by-name' AS name, 9 AS id;

statement ok
INSERT INTO {UC_TEST_TABLE} (name, id) VALUES ('column-list', 8);

# -----------------------------------------------------------------------------
# Columns left out
#

statement ok
INSERT INTO {UC_TEST_TABLE} (id) VALUES (7);

statement ok
INSERT INTO {UC_TEST_TABLE} DEFAULT VALUES;

# -----------------------------------------------------------------------------
# What landed
#
# Values, not counts: every shape above commits a row either way, and only the values say whether it
# went to the right column.
#

query II
SELECT id, name FROM {UC_TEST_TABLE} WHERE id IS NOT NULL ORDER BY id;
----
7	NULL
8	column-list
9	by-name

query I
SELECT count(*) FROM {UC_TEST_TABLE} WHERE id IS NULL AND name IS NULL;
----
1

statement ok
USE memory;
