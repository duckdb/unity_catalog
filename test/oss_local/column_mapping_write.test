# name: test/oss_local/column_mapping_write.test
# description: a write through the UC catalog path addresses a column-mapped table physically -- column_mapping_write.py hand-seeds the _delta_log and drives this body once per mapping mode
# group: [oss_local]

require parquet

require unity_catalog

require delta

require httpfs

require json

require-env UC_TEST_CATALOG

require-env UC_TEST_SCHEMA

require-env UC_TEST_TABLE

require-env UC_TEST_TABLE_LOCATION

require-env UC_TEST_UNMAPPED_TABLE

require-env UC_TEST_UNMAPPED_LOCATION

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH '{UC_TEST_CATALOG}' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA '{UC_TEST_SCHEMA}');

statement ok
USE duck.{UC_TEST_SCHEMA};

# -----------------------------------------------------------------------------
# The row survives the round trip
#

statement ok
INSERT INTO {UC_TEST_TABLE} VALUES (1, 'ABC');

# The values, not the count: a column the reader cannot resolve comes back NULL, which leaves the
# count right and the row unfindable.
query II
SELECT id, code FROM {UC_TEST_TABLE} ORDER BY id;
----
1	ABC

# -----------------------------------------------------------------------------
# The file is addressed physically
#
# The fixture ships no data files, so every parquet here is one this write produced.
#

query II
SELECT name, field_id FROM parquet_schema('{UC_TEST_TABLE_LOCATION}/duckdb-*.parquet')
WHERE name <> 'duckdb_schema' ORDER BY name;
----
col-aaaa	1
col-bbbb	2

# Asserting the logical name is *absent* is the half that matters: statistics keyed logically are
# silently unusable to a reader resolving physically, and every other assertion here still passes.
query II
SELECT add.stats LIKE '%col-bbbb%', add.stats LIKE '%"code"%'
FROM read_json('{UC_TEST_TABLE_LOCATION}/_delta_log/00000000000000000001.json') WHERE add IS NOT NULL;
----
true	false

# -----------------------------------------------------------------------------
# A table without column mapping is untouched
#
# Same shape, same statement, same attach -- so a green result above cannot come from field ids
# being emitted for everything.
#

statement ok
INSERT INTO {UC_TEST_UNMAPPED_TABLE} VALUES (1, 'ABC');

query II
SELECT id, code FROM {UC_TEST_UNMAPPED_TABLE} ORDER BY id;
----
1	ABC

query II
SELECT name, field_id FROM parquet_schema('{UC_TEST_UNMAPPED_LOCATION}/duckdb-*.parquet')
WHERE name <> 'duckdb_schema' ORDER BY name;
----
code	NULL
id	NULL

# `USE` above made duck the default database, which cannot be detached while selected
statement ok
USE memory;

statement ok
DETACH duck;
