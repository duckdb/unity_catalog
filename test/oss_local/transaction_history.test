# name: test/oss_local/transaction_history.test
# description: a transaction keeps reading the table it first read when another connection commits to it
# group: [oss_local]

require parquet

require unity_catalog

require delta

require httpfs

require-env UC_TEST_CATALOG

require-env UC_TEST_SCHEMA

require-env UC_TEST_TABLE

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH '{UC_TEST_CATALOG}' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA '{UC_TEST_SCHEMA}');

statement ok
INSERT INTO duck.{UC_TEST_SCHEMA}.{UC_TEST_TABLE} VALUES (1, 'one');

# -----------------------------------------------------------------------------
# A commit from another connection is invisible to a transaction that already read the table
#

statement ok con1
BEGIN;

query I con1
SELECT count(*) FROM duck.{UC_TEST_SCHEMA}.{UC_TEST_TABLE};
----
1

statement ok con2
INSERT INTO duck.{UC_TEST_SCHEMA}.{UC_TEST_TABLE} VALUES (2, 'two');

query I con1
SELECT count(*) FROM duck.{UC_TEST_SCHEMA}.{UC_TEST_TABLE};
----
1

statement ok con1
COMMIT;

query I con1
SELECT count(*) FROM duck.{UC_TEST_SCHEMA}.{UC_TEST_TABLE};
----
2
