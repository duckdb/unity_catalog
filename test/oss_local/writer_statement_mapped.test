# name: test/oss_local/writer_statement_mapped.test
# description: an insert omitting a column added after creation, on a column-mapped table, through the UC catalog path -- writer_statement_mapped.py stages the committed log
# group: [oss_local]

require parquet

require unity_catalog

require delta

require httpfs

require json

require-env UC_TEST_CATALOG

require-env UC_TEST_SCHEMA

require-env UC_TEST_TABLE

require-env UC_TEST_TABLE_LOCATION

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH '{UC_TEST_CATALOG}' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA '{UC_TEST_SCHEMA}');

statement ok
USE duck.{UC_TEST_SCHEMA};

# -----------------------------------------------------------------------------
# The omitted column is the one added in the second commit
#

statement ok
INSERT INTO {UC_TEST_TABLE} (id, name) VALUES (2, 'b');

query III
SELECT id, name, age FROM {UC_TEST_TABLE} ORDER BY id;
----
2	b	NULL

# -----------------------------------------------------------------------------
# The file is addressed physically, including the column that was left out
#
# The fixture ships no data files, so this parquet is the one the insert produced. A writer reading
# the creation schema would know col-aaaa and col-bbbb and miss col-cccc entirely.
#

query II
SELECT name, field_id FROM parquet_schema('{UC_TEST_TABLE_LOCATION}/duckdb-*.parquet')
WHERE name <> 'duckdb_schema' ORDER BY name;
----
col-aaaa	1
col-bbbb	2
col-cccc	3

# Stats keyed logically are silently unusable to a reader resolving physically.
query II
SELECT add.stats LIKE '%col-bbbb%', add.stats LIKE '%"name"%'
FROM read_json('{UC_TEST_TABLE_LOCATION}/_delta_log/00000000000000000002.json') WHERE add IS NOT NULL;
----
true	false

statement ok
USE memory;
