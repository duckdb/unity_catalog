# name: test/databricks/scan_plan_fallback.test
# description: A dead API_IRC_ENDPOINT_OVERRIDE makes every /plan call fail; the scan must still
# return correct rows via the Delta fallback (the delegate-swap in uc_table_entry.cpp) and log the
# api-irc fallback WARNING -- i.e. an unavailable scan-plan endpoint never errors the query.
# group: [databricks]

#
# Same premade table as scan_plan.test (scan_plan_days_managed: id INT, day VARCHAR, 5 files,
# 10 rows/file, ids 1-50). use_irc_scan_plan is on, but the IRC base is overridden to an
# unreachable endpoint, so the scan exercises the /plan-failure -> Delta fallback.

require parquet

require unity_catalog

require delta

require httpfs

require-env DATABRICKS_TOKEN

require-env DATABRICKS_ENDPOINT

require-env DATABRICKS_REGION

require-env CATALOG

require-env SCHEMA

statement ok
CALL enable_logging(level='DEBUG');

statement ok
CREATE SECRET (
    TYPE unity_catalog,
    TOKEN '{DATABRICKS_TOKEN}',
    ENDPOINT '{DATABRICKS_ENDPOINT}',
    AWS_REGION '{DATABRICKS_REGION}'
);

# Opt into scan-plan, but point the IRC base at an unreachable endpoint so every /plan call fails.
statement ok
ATTACH '{CATALOG}' AS unity (TYPE unity_catalog, READ_ONLY, DEFAULT_SCHEMA '{SCHEMA}',
    use_irc_scan_plan true, api_irc_endpoint_override 'http://127.0.0.1:1');

statement ok
USE unity;

statement ok
CALL truncate_duckdb_logs();

# The scan succeeds via the Delta fallback despite the dead /plan endpoint (5 files, 50 rows).
query I
SELECT count(*) FROM scan_plan_days_managed;
----
50

# A predicate still returns the right rows (DuckDB's Filter operator applies it over the Delta scan).
query I
SELECT count(*) FROM scan_plan_days_managed WHERE day = 'Mon';
----
10

# The fallback logged its WARNING naming the /plan failure.
query I
SELECT (count(*) > 0)::INT FROM duckdb_logs()
WHERE message LIKE 'api-irc.PlanTableScan% failed, falling back to Delta%';
----
1

statement ok
USE memory;

statement ok
DETACH unity;
