# name: test/databricks/scan_plan_deletes.test
# description: scan-plan delete-file resolution (BuildUCDeleteFilter) against a table with actual deletes.
# group: [databricks]

#
# Live-verified. scan_plan_days_deletes is 5 files, one row per file deleted after a
# deletion-vector-enabling DELETE. Databricks surfaces these as `deletion-vector-v1` puffin blobs,
# which BuildUCDeleteFilter -> ScanDeletionVectorFile (uc_puffin) decodes and applies. The row-count
# assertions below prove the correct rows are dropped; the scan-plan.DeletionVector log assertion
# proves it travelled the puffin/DV path specifically (not classic parquet position-deletes). See
# docs/scan-plan-design.md.
#
# TODO: the DELETE that defines the deleted rows lives in the fixture
# (data/scan_plan_days_deletes.sql) because it must run server-side at provision time to
# materialize the deletion vectors this read-only .test then reads -- it can't move into the test
# body. This split would read cleaner as a pure-Python test (cf. test/irc/test_irc_api_retry.py)
# co-locating provisioning + assertions, unless we adopt an advanced-sqllogic oracle (read_parquet
# differential comparison, per duckdb-iceberg #1204).

require parquet

require unity_catalog

require delta

require httpfs

require-env DATABRICKS_TOKEN

require-env DATABRICKS_ENDPOINT

require-env DATABRICKS_REGION

require-env DATABRICKS_SCAN_PLAN_ENDPOINT

require-env CATALOG

require-env SCHEMA

statement ok
CALL enable_logging(level='DEBUG');

statement ok
CREATE SECRET (
    TYPE unity_catalog,
    TOKEN '{DATABRICKS_TOKEN}',
    ENDPOINT '{DATABRICKS_ENDPOINT}',
    AWS_REGION '{DATABRICKS_REGION}'
);

statement ok
ATTACH '{CATALOG}' AS unity (TYPE unity_catalog, READ_ONLY, DEFAULT_SCHEMA '{SCHEMA}',
    scan_plan_endpoint '{DATABRICKS_SCAN_PLAN_ENDPOINT}');

statement ok
USE unity;

# -----------------------------------------------------------------------------
# Full scan: 50 rows written; ids 5, 15, 25, 35, 45 deleted (the last row of each weekday file,
# via the provision-time DELETE in data/scan_plan_days_deletes.sql) -> 45 remain.
#

query I
SELECT count(*) FROM scan_plan_days_deletes;
----
45

query I
SELECT count(*) FROM scan_plan_days_deletes WHERE id IN (5, 15, 25, 35, 45);
----
0

# -----------------------------------------------------------------------------
# Confirm the delete travelled the deletion-vector (puffin) path, not classic parquet
# position-deletes. scan-plan.DeletionVector is emitted ONLY by ScanDeletionVectorFile (a
# content-offset -> puffin blob), so this turns the counts above from "some delete was applied"
# into "the puffin/DV path we built is what ran". If Databricks ever switches to parquet
# position-delete files, this flips to 0 and scan-plan.PositionalDelete appears instead.
#

statement ok
CALL truncate_duckdb_logs();

statement ok
SELECT count(*) FROM scan_plan_days_deletes;

query I
SELECT (count(*) > 0)::INT FROM duckdb_logs()
WHERE message LIKE 'scan-plan.DeletionVector%';
----
1

# -----------------------------------------------------------------------------
# Filter pushdown + delete application together: day = 'Mon' still prunes to 1 file,
# and the deleted id (5) must not reappear even though the file-level filter is unrelated
# to the delete.
#

query I
SELECT count(*) FROM scan_plan_days_deletes WHERE day = 'Mon';
----
9

query II
SELECT min(id), max(id) FROM scan_plan_days_deletes WHERE day = 'Mon';
----
1	10

statement ok
DETACH unity;
